server {
    listen 80;
    listen [::]:80;
    server_name secretinc.ru www.secretinc.ru;
    return 301 https://secretinc.ru$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name secretinc.ru www.secretinc.ru;

    root /var/www/secretinc.ru/current;
    index index.html;

    ssl_certificate /etc/ssl/certs/secretinc.ru.crt;
    ssl_certificate_key /etc/ssl/private/secretinc.ru.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        try_files $uri $uri/ =404;
    }
}
